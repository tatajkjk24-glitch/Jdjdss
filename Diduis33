local playerData = {}

local function getPlayerTotalTime(userId)
    local pInfo = playerData[userId]
    if not pInfo then return 0 end
    if pInfo.isOnline and pInfo.joinTime then
        return pInfo.totalTime + (os.time() - pInfo.joinTime)
    else
        return pInfo.totalTime
    end
end

local function trackPlayer(plr)
    if not playerData[plr.UserId] then
        playerData[plr.UserId] = {
            totalTime = 0, joinTime = os.time(), isOnline = true, joins = 1, leaves = 0, name = plr.Name, displayName = plr.DisplayName
        }
    else
        playerData[plr.UserId].joinTime = os.time()
        playerData[plr.UserId].isOnline = true
        playerData[plr.UserId].joins = playerData[plr.UserId].joins + 1
    end
end

for _, plr in pairs(Players:GetPlayers()) do trackPlayer(plr) end
Players.PlayerAdded:Connect(trackPlayer)


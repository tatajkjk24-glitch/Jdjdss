local function createPlayerCard(targetPlr)
    local cardName = "Card_" .. targetPlr.UserId
    if playerList:FindFirstChild(cardName) then return end

    local card = Instance.new("Frame", playerList)
    card.Name = cardName
    card.Size, card.BackgroundColor3 = UDim2.new(1, -6, 0, 48), Color3.fromRGB(45, 10, 70)
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 8)
    
    local nameLbl = Instance.new("TextLabel", card)
    nameLbl.Size, nameLbl.Position, nameLbl.BackgroundTransparency = UDim2.new(0.6, 0, 0, 18), UDim2.new(0, 10, 0, 4), 1
    nameLbl.Text, nameLbl.TextColor3, nameLbl.Font = targetPlr.Name, Color3.fromRGB(255, 255, 255), Enum.Font.GothamBold

    local infoLbl = Instance.new("TextLabel", card)
    infoLbl.Size, infoLbl.Position, infoLbl.BackgroundTransparency = UDim2.new(0.8, 0, 0, 18), UDim2.new(0, 10, 0, 22), 1
    infoLbl.TextColor3, infoLbl.Font, infoLbl.TextSize = Color3.fromRGB(200, 180, 220), Enum.Font.Gotham, 10

    task.spawn(function()
        while card and card.Parent do
            local pInfo = playerData[targetPlr.UserId]
            if pInfo then
                local elapsed = getPlayerTotalTime(targetPlr.UserId)
                infoLbl.Text = string.format("Joins: %d | Leaves: %d | Time: %02d:%02d:%02d", pInfo.joins, pInfo.leaves, math.floor(elapsed/3600), math.floor((elapsed%3600)/60), elapsed%60)
            end
            task.wait(1)
        end
    end)
end


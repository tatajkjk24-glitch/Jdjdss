local function sendMsg()
    local rawText = msgInput.Text
    if rawText:match("%S") then
        local msgLabel = Instance.new("TextLabel", chatBoxFrame)
        msgLabel.Size = UDim2.new(1, -12, 0, 0)
        msgLabel.BackgroundTransparency = 1
        msgLabel.Text = "[" .. LocalPlayer.Name .. "]: " .. rawText
        msgLabel.TextColor3 = Color3.fromRGB(235, 235, 235)
        msgLabel.Font = Enum.Font.Gotham
        msgLabel.TextSize = 13
        msgLabel.TextWrapped = true
        msgLabel.TextXAlignment = Enum.TextXAlignment.Left
        msgLabel.AutomaticSize = Enum.AutomaticSize.Y
        
        msgInput.Text = ""
        task.wait(0.1)
        chatBoxFrame.CanvasPosition = Vector2.new(0, chatBoxFrame.AbsoluteCanvasSize.Y)
    end
end

sendBtn.MouseButton1Click:Connect(sendMsg)
msgInput.FocusLost:Connect(function(enterPressed)
    if enterPressed then sendMsg() end
end)

Players.PlayerRemoving:Connect(function(plr)
    local pInfo = playerData[plr.UserId]
    if pInfo then
        if pInfo.isOnline and pInfo.joinTime then
            pInfo.totalTime = pInfo.totalTime + (os.time() - pInfo.joinTime)
            pInfo.joinTime = nil
        end
        pInfo.isOnline = false
        pInfo.leaves = pInfo.leaves + 1
    end

    local cardName = "Card_" .. plr.UserId
    if playerList:FindFirstChild(cardName) then
        leaveSound:Play()
    end
end)
